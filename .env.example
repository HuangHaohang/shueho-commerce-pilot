# Gateway HTTP listener.
COMMERCE_AGENT_HOST=127.0.0.1
COMMERCE_AGENT_PORT=8787
# Required in production. Next.js BFF and Gateway must share this secret;
# browsers never receive it.
COMMERCE_GATEWAY_INTERNAL_TOKEN=
# Interactive turns are interrupted by the Gateway after this deadline.
COMMERCE_AGENT_MAX_TURN_DURATION_MS=600000
# After a completed turn, call Codex thread/compact/start when the active
# input context reaches this percentage of the model context window.
COMMERCE_AGENT_AUTO_COMPACT_THRESHOLD_PERCENT=75
# Maximum time allowed for one Harness compaction turn.
COMMERCE_AGENT_COMPACTION_TIMEOUT_MS=180000

# Optional Codex runtime override.
# By default the gateway uses ./node_modules/.bin/codex from the app dependency.
# CODEX_BIN=/absolute/path/to/codex

# Optional model defaults. Security policy is fixed by the application and
# cannot be overridden with environment variables or browser input.
CODEX_DEFAULT_MODEL=
CODEX_DEFAULT_MODEL_PROVIDER=

# Codex runtime state/config root for this web application instance.
# In production, mount this as app-owned persistent storage, not a developer home folder.
CODEX_HOME=.runtime/codex

# Application-owned OpenAI-compatible provider. Codex custom providers use
# the Responses wire API; Chat Completions is not a Codex provider protocol.
COMMERCE_PROVIDER_BASE_URL=https://cpa.luusmosh.com/v1
COMMERCE_PROVIDER_API_KEY=
COMMERCE_PROVIDER_ID=luusmosh_cpa
COMMERCE_PROVIDER_NAME="Luusmosh CPA"
COMMERCE_AGENT_MODEL_SELECTORS=gpt-5.5,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gemini-3.7-flash*,claude-sonnet-4-6,claude-opus-4-6-thinking
COMMERCE_PROVIDER_MODEL_CACHE_TTL_MS=60000
COMMERCE_IMAGE_MODEL=gpt-image-2
CODEX_DEFAULT_MODEL_PROVIDER=luusmosh_cpa
CODEX_DEFAULT_MODEL=gpt-5.6-sol
