# Gateway HTTP listener.
COMMERCE_AGENT_HOST=127.0.0.1
COMMERCE_AGENT_PORT=8787
# Required in production. Next.js BFF and Gateway must share this secret;
# browsers never receive it.
COMMERCE_GATEWAY_INTERNAL_TOKEN=
# Interactive turns are interrupted by the Gateway after this deadline.
COMMERCE_AGENT_MAX_TURN_DURATION_MS=600000
# After a completed turn, request admitted Codex compaction when cumulative
# totalTokens reaches this percentage of the model context window.
COMMERCE_AGENT_AUTO_COMPACT_THRESHOLD_PERCENT=75
# Maximum time allowed for one Harness compaction turn.
COMMERCE_AGENT_COMPACTION_TIMEOUT_MS=180000
# Internal, non-public BFF callback used for tenant-scoped usage and turn
# lifecycle events. The durable Gateway outbox retries with capped exponential
# backoff and quarantines permanent contract failures to a dead-letter file.
COMMERCE_AGENT_EVENT_SINK_URL=http://127.0.0.1:3000/api/internal/agent-events
# Required in production. Active root jobs and host tools fail closed through
# this private BFF authorization callback.
COMMERCE_AGENT_AUTHORIZATION_URL=http://127.0.0.1:3000/api/internal/agent-authorization
# Required in production. Automatic and Harness compaction reserve/release
# Enterprise quota through this private BFF callback.
COMMERCE_AGENT_ADMISSION_URL=http://127.0.0.1:3000/api/internal/agent-admission
# Private BFF callback for external-data authorization, budget reservation,
# approval state, audit, and billing settlement.
COMMERCE_EXTERNAL_DATA_CONTROL_URL=http://127.0.0.1:3000/api/internal/external-data
# 5000-60000 milliseconds; authorization failure revokes active root work.
COMMERCE_AGENT_AUTHORIZATION_POLL_MS=10000
# 1-16 Codex agent threads inside one root session. Keep this equal to or below
# the tenant contract's max_agent_threads_per_session (default 4).
COMMERCE_AGENT_MAX_THREADS_PER_SESSION=4
# Required in production: this Gateway accepts only this Enterprise tenant UUID.
# Run one Gateway/App Server/CODEX_HOME/provider-secret set per tenant.
COMMERCE_RUNTIME_TENANT_ID=

# Internal SHUEHO external-data MCP. The Gateway never connects to JustOneAPI
# MCP and never receives the JustOneAPI REST Token. Use the same internal token
# in apps/external-data/.env; browsers and customer MCP clients never receive it.
EXTERNAL_DATA_SERVICE_MCP_URL=http://127.0.0.1:8791/mcp
EXTERNAL_DATA_SERVICE_MCP_TOKEN=
EXTERNAL_DATA_SERVICE_MCP_TIMEOUT_MS=300000
EXTERNAL_DATA_SERVICE_MCP_MAX_RESULT_BYTES=1048576

# Separate public Streamable HTTP MCP listener. Publish this port only behind
# TLS and an ingress that preserves Authorization headers. Port 8787 remains
# private Gateway infrastructure.
COMMERCE_PUBLIC_MCP_HOST=127.0.0.1
COMMERCE_PUBLIC_MCP_PORT=8790
COMMERCE_PUBLIC_MCP_ALLOWED_HOSTS=127.0.0.1:8790,localhost:8790
COMMERCE_PUBLIC_MCP_ALLOWED_ORIGINS=
COMMERCE_MCP_AUTH_URL=http://127.0.0.1:3000/api/internal/mcp-auth
COMMERCE_PUBLIC_MCP_URL=http://127.0.0.1:8790/mcp
COMMERCE_EXTERNAL_DATA_RETENTION_INTERVAL_MS=21600000
COMMERCE_EXTERNAL_DATA_RETENTION_BATCH_SIZE=500

# Public legal disclosures. A production deployment is not launch-ready until
# all five values identify the actual operating entity and working contacts.
COMMERCE_LEGAL_ENTITY_NAME=
COMMERCE_LEGAL_CREDIT_CODE=
COMMERCE_LEGAL_REGISTERED_ADDRESS=
COMMERCE_LEGAL_SERVICE_EMAIL=
COMMERCE_LEGAL_PRIVACY_EMAIL=

# Optional Codex runtime override.
# By default the gateway uses ./node_modules/.bin/codex from the app dependency.
# CODEX_BIN=/absolute/path/to/codex

# Optional model defaults. Security policy is fixed by the application and
# cannot be overridden with environment variables or browser input.
CODEX_DEFAULT_MODEL=
CODEX_DEFAULT_MODEL_PROVIDER=

# Codex runtime state/config root for this tenant-dedicated application instance.
# In production, mount a tenant-specific persistent volume, never a developer
# home folder or a volume shared by customer companies.
CODEX_HOME=.runtime/codex

# Application-owned OpenAI-compatible provider. Codex custom providers use
# the Responses wire API; Chat Completions is not a Codex provider protocol.
COMMERCE_PROVIDER_BASE_URL=https://cpa.luusmosh.com/v1
COMMERCE_PROVIDER_API_KEY=
COMMERCE_PROVIDER_ID=luusmosh_cpa
COMMERCE_PROVIDER_NAME="Luusmosh CPA"
COMMERCE_AGENT_MODEL_SELECTORS=gpt-5.5,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol,gemini-3.7-flash*,claude-sonnet-4-6,claude-opus-4-6-thinking
COMMERCE_TITLE_MODEL=gpt-5.3-codex-spark
COMMERCE_PROVIDER_MODEL_CACHE_TTL_MS=60000
# Dedicated sourced-search model. Keep retries visible to the Harness so it can
# shorten the next query instead of repeating one expensive hidden request.
COMMERCE_WEB_SEARCH_MODEL=gpt-5.6-luna
COMMERCE_WEB_SEARCH_TIMEOUT_MS=30000
COMMERCE_WEB_SEARCH_MAX_ATTEMPTS=1
COMMERCE_IMAGE_MODEL=gpt-image-2
CODEX_DEFAULT_MODEL_PROVIDER=luusmosh_cpa
CODEX_DEFAULT_MODEL=gpt-5.6-sol
