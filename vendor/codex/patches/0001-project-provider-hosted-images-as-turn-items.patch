+#[tokio::test]
+async fn hosted_image_generation_is_projected_without_dispatching_a_tool() {
+    let (session, turn_context, rx) = make_session_and_context_with_rx().await;
+    let provisional = handle_non_tool_response_item(
+        session.as_ref(),
+        TurnItemContributorPolicy::Skip,
+        &hosted_image_generation_output(),
+        /*plan_mode*/ false,
+    )
+    .await
+    .expect("hosted image generation should parse");
+
+    let TurnItem::ImageGeneration(image) = provisional else {
+        panic!("expected image generation item");
+    };
+    assert_eq!(image, expected_hosted_image_generation_item());
+
+    let step_context = StepContext::for_test(Arc::clone(&turn_context));
+    let (registry, hosted_specs) = tool_registry_for_test_step(step_context.as_ref());
+    let router = Arc::new(ToolRouter::from_registry(
+        step_context.turn.as_ref(),
+        registry,
+        hosted_specs,
+        &Default::default(),
+    ));
+    let step_context = step_context.with_tool_router_for_test(router);
+    let tracker = Arc::new(tokio::sync::Mutex::new(TurnDiffTracker::new()));
+    let tool_runtime = ToolCallRuntime::new(Arc::clone(&session), step_context, tracker);
+    let mut ctx = HandleOutputCtx {
+        sess: session,
+        turn_context: Arc::clone(&turn_context),
+        turn_store: Arc::new(ExtensionData::new(turn_context.sub_id.clone())),
+        tool_runtime,
+        cancellation_token: CancellationToken::new(),
+    };
+
+    let output = handle_output_item_done(
+        &mut ctx,
+        hosted_image_generation_output(),
+        /*previously_active_item*/ None,
+    )
+    .await
+    .expect("hosted image generation should complete");
+
+    assert_eq!(
+        (
+            output.tool_future.is_some(),
+            output.needs_follow_up,
+            output.last_agent_message,
+        ),
+        (false, false, None),
+    );
+
+    let started = rx.recv().await.expect("image item should start");
+    let EventMsg::ItemStarted(started) = started.msg else {
+        panic!("expected item started event");
+    };
+    let TurnItem::ImageGeneration(started_image) = started.item else {
+        panic!("expected started image generation item");
+    };
+    assert_eq!(started_image, expected_hosted_image_generation_item());
+
+    let begin = rx.recv().await.expect("legacy image lifecycle should begin");
+    let EventMsg::ImageGenerationBegin(begin) = begin.msg else {
+        panic!("expected legacy image generation begin event");
+    };
+    assert_eq!(
+        serde_json::to_value(begin).expect("serialize image generation begin"),
+        json!({"call_id": "ig_hosted-1"}),
+    );
+
+    let completed = rx.recv().await.expect("image item should complete");
+    let EventMsg::ItemCompleted(completed) = completed.msg else {
+        panic!("expected item completed event");
+    };
+    let TurnItem::ImageGeneration(completed_image) = completed.item else {
+        panic!("expected completed image generation item");
+    };
+    assert_eq!(completed_image, expected_hosted_image_generation_item());
+
+    let end = rx.recv().await.expect("legacy image lifecycle should end");
+    let EventMsg::ImageGenerationEnd(end) = end.msg else {
+        panic!("expected legacy image generation end event");
+    };
+    assert_eq!(
+        serde_json::to_value(end).expect("serialize image generation end"),
+        json!({
+            "call_id": "ig_hosted-1",
+            "status": "completed",
+            "revised_prompt": "A product image on a neutral background",
+            "result": "cG5n",
+        }),
+    );
+    let raw = rx
+        .recv()
+        .await
+        .expect("raw image response item should persist");
+    let EventMsg::RawResponseItem(raw) = raw.msg else {
+        panic!("expected raw response item event");
+    };
+    let ResponseItem::ImageGenerationCall {
+        id,
+        status,
+        revised_prompt,
+        result,
+        internal_chat_message_metadata_passthrough,
+    } = raw.item
+    else {
+        panic!("expected raw hosted image generation response item");
+    };
+    assert_eq!(
+        (
+            id.map(|id| id.to_string()),
+            status,
+            revised_prompt,
+            result,
+            internal_chat_message_metadata_passthrough.and_then(|metadata| metadata.turn_id),
+        ),
+        (
+            Some("ig_hosted-1".to_string()),
+            "completed".to_string(),
+            Some("A product image on a neutral background".to_string()),
+            "cG5n".to_string(),
+            Some(turn_context.sub_id.clone()),
+        ),
+    );
+    assert!(
+        rx.try_recv().is_err(),
+        "no tool execution or follow-up events expected"
+    );
+}
