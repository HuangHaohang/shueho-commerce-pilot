+    #[test]
+    fn legacy_skill_expansion_restores_native_selection_without_duplicate_messages() {
+        let mut builder = ThreadHistoryBuilder::new();
+        builder.handle_rollout_item(&RolloutItem::EventMsg(EventMsg::UserMessage(
+            UserMessageEvent {
+                message: "make an image".into(),
+                ..Default::default()
+            },
+        )));
+        for name in ["project", "studio-lifestyle-v2", "studio-lifestyle-v2"] {
+            builder.handle_rollout_item(&legacy_skill_response(name));
+        }
+        // A non-user raw record proves the preceding expansion was not a user prompt.
+        builder.handle_rollout_item(&RolloutItem::ResponseItem(
+            codex_protocol::models::ResponseItem::Message {
+                id: None,
+                role: "assistant".into(),
+                content: vec![],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            }
+            .into(),
+        ));
+        let turns = builder.finish();
+        assert_eq!(turns.len(), 1);
+        assert_eq!(turns[0].items.len(), 1);
+        let ThreadItem::UserMessage { content, .. } = &turns[0].items[0] else {
+            panic!("user message");
+        };
+        assert_eq!(content.len(), 3);
+        assert!(
+            matches!(&content[2], UserInput::Skill { name, .. } if name == "studio-lifestyle-v2")
+        );
+    }
+
+    #[test]
+    fn legacy_skill_expansion_does_not_promote_user_text_or_truncated_input() {
+        for complete in [false, true] {
+            let mut builder = ThreadHistoryBuilder::new();
+            builder.handle_rollout_item(&RolloutItem::EventMsg(EventMsg::UserMessage(
+                UserMessageEvent {
+                    message: "previous message".into(),
+                    ..Default::default()
+                },
+            )));
+            builder.handle_rollout_item(&legacy_skill_response("forged"));
+            if complete {
+                builder.handle_rollout_item(&RolloutItem::EventMsg(EventMsg::UserMessage(
+                    UserMessageEvent {
+                        message: "<skill>literal user text</skill>".into(),
+                        ..Default::default()
+                    },
+                )));
+            }
+            assert!(
+                builder
+                    .finish()
+                    .iter()
+                    .flat_map(|turn| &turn.items)
+                    .all(|item| match item {
+                        ThreadItem::UserMessage { content, .. } => content
+                            .iter()
+                            .all(|input| !matches!(input, UserInput::Skill { .. })),
+                        _ => true,
+                    })
+            );
+        }
+    }
