# Runtime traffic must use the least-privilege, non-superuser, non-BYPASSRLS
# application role. Production checks these PostgreSQL role flags and refuses
# to run when either is unsafe.
DATABASE_URL=postgresql://commerce_pilot_app:commerce_pilot_app_dev@127.0.0.1:55432/commerce_pilot
# Useful in CI/local isolation tests; production enforces role safety regardless.
COMMERCE_ENFORCE_DATABASE_RLS=true
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call authentication endpoints.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Enterprise-only: production always requires an email-matching invitation and
# ignores a true override. Local bootstrap/E2E may explicitly opt in.
COMMERCE_ALLOW_PUBLIC_REGISTRATION=false

# Server-to-server connection to the correct tenant-dedicated Gateway. The
# current BFF has one static URL; use a customer-specific deployment/route until
# tenant-aware runtime routing exists. Use the same 32+ character secret as the
# Gateway process in production. Never expose either value through NEXT_PUBLIC_*.
COMMERCE_GATEWAY_URL=http://127.0.0.1:8787
COMMERCE_GATEWAY_INTERNAL_TOKEN=
# Required by durable Web-owned workers. Use the same provisioned tenant UUID
# as the tenant-dedicated Gateway; never let a worker discover work globally.
COMMERCE_RUNTIME_TENANT_ID=

# The public MCP service calls these private BFF routes with the same internal
# service token. They must not be internet-addressable.
COMMERCE_EXTERNAL_DATA_CONTROL_URL=http://127.0.0.1:3000/api/internal/external-data
COMMERCE_MCP_AUTH_URL=http://127.0.0.1:3000/api/internal/mcp-auth
COMMERCE_PUBLIC_MCP_URL=http://127.0.0.1:8790/mcp
COMMERCE_EXTERNAL_DATA_RETENTION_INTERVAL_MS=21600000
COMMERCE_EXTERNAL_DATA_RETENTION_BATCH_SIZE=500
COMMERCE_PRODUCT_RETENTION_INTERVAL_MS=21600000
COMMERCE_PRODUCT_RETENTION_BATCH_SIZE=100

# Optional operator-owned Product Catalog connector secret. Register its env
# name with enterprise:provision-product-secret; browsers and Harness receive
# only a tenant/workspace-bound opaque handle. Use a SELECT-only, non-superuser,
# non-BYPASSRLS PostgreSQL role. Non-loopback connections must include
# sslmode=require, verify-ca, or verify-full. Do not reuse Commerce Pilot's own
# DATABASE_URL in production.
COMMERCE_PRODUCT_SOURCE_EXAMPLE_READONLY_DATABASE=

COMMERCE_LEGAL_ENTITY_NAME=
COMMERCE_LEGAL_CREDIT_CODE=
COMMERCE_LEGAL_REGISTERED_ADDRESS=
COMMERCE_LEGAL_SERVICE_EMAIL=
COMMERCE_LEGAL_PRIVACY_EMAIL=

# OTP delivery is intentionally disabled in this phase. Future provider
# implementations must be selected explicitly instead of silently logging codes.
AUTH_EMAIL_DELIVERY_PROVIDER=disabled
AUTH_SMS_DELIVERY_PROVIDER=disabled
