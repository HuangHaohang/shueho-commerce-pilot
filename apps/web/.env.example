# Runtime traffic must use the least-privilege, non-superuser, non-BYPASSRLS
# application role. Production checks these PostgreSQL role flags and refuses
# to run when either is unsafe.
DATABASE_URL=postgresql://commerce_pilot_app:commerce_pilot_app_dev@127.0.0.1:55432/commerce_pilot
# Useful in CI/local isolation tests; production enforces role safety regardless.
COMMERCE_ENFORCE_DATABASE_RLS=true
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins allowed to call authentication endpoints.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Enterprise-only: production always requires an email-matching invitation and
# ignores a true override. Local bootstrap/E2E may explicitly opt in.
COMMERCE_ALLOW_PUBLIC_REGISTRATION=false

# Server-to-server connection to the correct tenant-dedicated Gateway. The
# current BFF has one static URL; use a customer-specific deployment/route until
# tenant-aware runtime routing exists. Use the same 32+ character secret as the
# Gateway process in production. Never expose either value through NEXT_PUBLIC_*.
COMMERCE_GATEWAY_URL=http://127.0.0.1:8787
COMMERCE_GATEWAY_INTERNAL_TOKEN=

# OTP delivery is intentionally disabled in this phase. Future provider
# implementations must be selected explicitly instead of silently logging codes.
AUTH_EMAIL_DELIVERY_PROVIDER=disabled
AUTH_SMS_DELIVERY_PROVIDER=disabled
